---
// Shared <head> for every page: SEO, Open Graph, canonical, favicon.
// Concept pages pass their own title/description/ogImage and theme color.
import "../styles/global.css";
import { SITE_URL } from "../site.js";

interface Props {
  title: string;
  description: string;
  ogImage?: string; // path under /public, e.g. "/og/dental-clinic.png"
  themeColor?: string;
  lang?: string;
  showConceptBadge?: boolean;
}

const {
  title,
  description,
  ogImage = "/og/default.png",
  themeColor = "#ffffff",
  lang = "en",
  showConceptBadge = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogUrl = new URL(ogImage, SITE_URL).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    {
      showConceptBadge && (
        <a class="concept-badge" href="/" title="This is a concept site with a fictional brand. See all concepts">
          Concept · fictional brand
        </a>
      )
    }
  </body>
</html>
