---
// Small line icons drawn for this concept (24x24, stroke uses currentColor).
interface Props {
  name: string;
  size?: number;
}
const { name, size = 24 } = Astro.props;
const paths: Record<string, string> = {
  bolt: '<path d="M13 3 5 14h6l-1 7 8-11h-6l1-7z"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15" rx="3"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
  sparkle: '<path d="M12 3c.6 4 2 5.4 6 6-4 .6-5.4 2-6 6-.6-4-2-5.4-6-6 4-.6 5.4-2 6-6zM19 15c.3 1.6.9 2.2 2.5 2.5-1.6.3-2.2.9-2.5 2.5-.3-1.6-.9-2.2-2.5-2.5 1.6-.3 2.2-.9 2.5-2.5z"/>',
  align: '<path d="M4 9c2.5-3 13.5-3 16 0M4 15c2.5 3 13.5 3 16 0"/><path d="M7 9v6M12 8v8M17 9v6"/>',
  gap: '<path d="M6 5c-2 0-3 2-2.5 5S5 19 7 19s2-4 3-4 1 4 3 4 3.5-6 4-9-.5-5-2.5-5c-1.5 0-2 1-3.5 1S7.5 5 6 5z" stroke-dasharray="2.5 2.5"/>',
  child: '<circle cx="12" cy="8" r="3.5"/><path d="M5.5 20c.8-4 3.4-6 6.5-6s5.7 2 6.5 6"/>',
  phone: '<path d="M5 4h3.5l1.5 4-2 1.5a11 11 0 0 0 6.5 6.5L16 14l4 1.5V19a1.5 1.5 0 0 1-1.6 1.5C10.5 20 4 13.5 3.5 5.6A1.5 1.5 0 0 1 5 4z"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  check: '<path d="M5 12.5 10 17l9-10"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0C18.5 15.4 12 21 12 21z"/><circle cx="12" cy="10" r="2.3"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
};
const body = paths[name] ?? paths.check;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={body}
/>
