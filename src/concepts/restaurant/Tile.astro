---
// Our own simplified 8-point star tile (two overlapping squares + a small rosette),
// repeated as an SVG pattern. Used as section divider and footer band.
interface Props {
  id: string;
  tone?: "light" | "dark" | "blue";
  height?: number;
}
const { id, tone = "light", height = 40 } = Astro.props;

const star = (cx: number, cy: number, R: number) => {
  const r = R * 0.765;
  const pts: string[] = [];
  for (let i = 0; i < 16; i++) {
    const a = (Math.PI / 8) * i - Math.PI / 2;
    const rad = i % 2 === 0 ? R : r;
    pts.push(`${(cx + rad * Math.cos(a)).toFixed(2)},${(cy + rad * Math.sin(a)).toFixed(2)}`);
  }
  return pts.join(" ");
};
---

<svg class={`tile tile-${tone}`} width="100%" height={height} aria-hidden="true" focusable="false">
  <defs>
    <pattern id={id} width="40" height="40" patternUnits="userSpaceOnUse">
      <rect class="tile-bg" width="40" height="40"></rect>
      <polygon class="tile-star" points={star(20, 20, 15)}></polygon>
      <polygon class="tile-inner" points={star(20, 20, 7.5)}></polygon>
      <circle class="tile-dot" cx="20" cy="20" r="2.2"></circle>
      <path class="tile-corner" d="M0 0h6L0 6zM40 0v6l-6-6zM0 40v-6l6 6zM40 40h-6l6-6z"></path>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`}></rect>
</svg>
