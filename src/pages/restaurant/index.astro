---
import "@fontsource-variable/anybody/wdth.css";
import "@fontsource-variable/instrument-sans/wdth.css";
import { existsSync } from "node:fs";
import Base from "../../layouts/Base.astro";
import Icon from "../../concepts/restaurant/Icon.astro";
import Tile from "../../concepts/restaurant/Tile.astro";
import Plate from "../../concepts/restaurant/Plate.astro";
import "../../concepts/restaurant/styles.css";
import {
  brand,
  nav,
  hours,
  specials,
  dietary,
  signature,
  menu,
  kahvalti,
  facts,
  team,
  setMenus,
  quotes,
  faq,
} from "../../concepts/restaurant/content.js";

const title = "Sumakara · Anatolian charcoal grill & meze in Halvern Square (concept)";
const description =
  "Concept website for a fictional Anatolian grill and meze house: an HTML menu with dietary filters, weekend kahvaltı, private mangal nights and table reservations.";

// Stock photos are optional (see docs/restaurant/PHOTOS.md). Render them only once downloaded.
const photo = (name: string) => (existsSync(`public/photos/restaurant/${name}.jpg`) ? `/photos/restaurant/${name}.jpg` : null);
const photoNames = ["hero", "coals", "fire", "kahvalti", "plate-adana", "plate-ezme", "plate-kunefe", "cat-meze", "cat-mangal", "cat-pide", "cat-sweets", "cat-drinks"];
const photos: Record<string, string | null> = Object.fromEntries(photoNames.map((n) => [n, photo(n)]));
const anyPhoto = Object.values(photos).some(Boolean);

const tagLabel = Object.fromEntries(dietary.map((d) => [d.id, d.label]));
const tagIcon: Record<string, string> = { veg: "leaf", vegan: "sprout", gf: "wheat", spicy: "flame" };
const fmtHours = (s: string[][]) => s.map(([a, b, label]) => `${a}–${b}${label ? ` (${label})` : ""}`).join(" · ");
const tickerWords = ["Meze", "Mangal", "Kahvaltı", "Lavaş from the coals", "Rakı", "Künefe", "Tea is on us"];
const embers = Array.from({ length: 16 }, (_, i) => ({
  left: (i * 37) % 100,
  s: 2 + (i % 4),
  d: 7 + ((i * 5) % 7),
  delay: -((i * 1.3) % 9),
  x: ((i % 2 ? 1 : -1) * (20 + ((i * 13) % 50))),
}));
---

<Base {title} {description} ogImage="/og/restaurant.png" themeColor="#170a0b">
  <div class="c-sumakara">
    <header class="site-header" data-header>
      <div class="pad header-inner">
        <a href="#top" class="logo">
          <svg width="28" height="28" viewBox="0 0 30 30" aria-hidden="true">
            <rect class="f-pom" x="5" y="5" width="20" height="20" rx="2"></rect>
            <rect class="f-pom" x="5" y="5" width="20" height="20" rx="2" transform="rotate(45 15 15)"></rect>
            <circle class="f-saffron" cx="15" cy="15" r="4.2"></circle>
          </svg>
          Sumakara
        </a>
        <nav class="main-nav" aria-label="Main">
          <ul>{nav.map((n) => <li><a href={n.href} data-nav-link>{n.label}</a></li>)}</ul>
        </nav>
        <p class="open-pill" data-open-pill><span class="dot" aria-hidden="true"></span><span data-open-text>Tue–Sun · see hours</span></p>
        <a class="btn btn-pom header-cta" href="#reserve">Reserve</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
          <span class="sr-only">Menu</span>
          <span data-icon-open><Icon name="menu" size={22} /></span>
          <span data-icon-close hidden><Icon name="close" size={22} /></span>
        </button>
      </div>
      <div class="mobile-menu" id="mobile-menu" data-open="false">
        <nav aria-label="Mobile">
          {nav.map((n) => <a class="big" href={n.href} data-menu-link>{n.label}</a>)}
        </nav>
        <a class="btn btn-fire" href="#reserve" data-menu-link>Reserve a table</a>
        <a class="btn btn-line" href={brand.phoneHref}><Icon name="phone" size={18} />{brand.phone}</a>
      </div>
    </header>

    <main id="main">
      <!-- HERO -->
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-media" aria-hidden="true">
          {photos.hero ? <img src={photos.hero} alt="" width="1066" height="1600" fetchpriority="high" /> : <div class="ph"></div>}
        </div>
        <div class="embers" aria-hidden="true">
          {embers.map((e) => <i style={`left:${e.left}%;--s:${e.s}px;--d:${e.d}s;--delay:${e.delay}s;--x:${e.x}px`}></i>)}
        </div>
        <span class="scroll-cue" aria-hidden="true">Scroll · the coals are lit</span>

        <div class="pad hero-copy">
          <div>
            <p class="hero-kicker">Meze · Mangal · Kahvaltı — Halvern Square</p>
            <p class="hero-lede">Anatolian charcoal grill and meze. Small plates to share, skewers off a two-meter oak-charcoal mangal.</p>
            <div class="hero-actions">
              <a class="btn btn-fire" href="#reserve">Reserve a table <Icon name="arrow" size={18} /></a>
              <a class="btn btn-line" href="#menu">See the menu</a>
            </div>
          </div>
          <div class="today" data-today>
            <span>Today</span>
            <strong data-today-hours>17:00–22:30</strong>
            <span>Walk-ins welcome at the bar</span>
          </div>
        </div>
        <h1 id="hero-title" class="wordmark" aria-label="Sumakara, Anatolian charcoal grill and meze">Sumakara</h1>
      </section>

      <!-- TICKER -->
      <div class="ticker" aria-hidden="true">
        <div class="ticker-track">
          {[0, 1].map(() => <ul>{tickerWords.map((w) => <li>{w}</li>)}</ul>)}
        </div>
      </div>

      <!-- 01 FIRE -->
      <section class="chapter fire" id="fire" aria-labelledby="fire-title">
        <figure class="fire-media">
          {photos.coals ? <img src={photos.coals} alt="Glowing oak charcoal in the mangal" width="1280" height="1600" loading="lazy" /> : <div class="ph" aria-hidden="true"></div>}
          <figcaption>Oak charcoal · lit at 16:00</figcaption>
        </figure>
        <div class="fire-content">
          <div class="reveal">
            <p class="chapter-mark"><b>01</b> The fire</p>
            <h2 class="chapter-title" id="fire-title" style="margin-top:1.25rem">One grill. Lit every afternoon, tended all night.</h2>
            <p class="body">
              Sumakara is built around a mangal: a long open charcoal grill like the ones on every street corner in
              southeastern Turkey. No gas, no shortcuts. Just oak coals, a cook who watches them, and food that tastes of the fire.
            </p>
          </div>
          {
            facts.map((f) => (
              <div class="fact reveal">
                <span class="n">{f.n}</span>
                <h3>{f.label}</h3>
                <p>{f.text}</p>
              </div>
            ))
          }
          <ul class="hands reveal" aria-label="The people at the fire">
            {
              team.map((t) => (
                <li class="hand">
                  <span class="ini" aria-hidden="true">{t.initials}</span>
                  <div>
                    <h3>{t.name}</h3>
                    <p class="role">{t.role}</p>
                    <p>{t.note}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- 02 TONIGHT -->
      <section class="chapter tonight pad" id="tonight" aria-labelledby="tonight-title">
        <div class="tonight-head reveal">
          <p class="chapter-mark"><b>02</b> Tonight</p>
          <h2 class="chapter-title" id="tonight-title">From the coals, this evening.</h2>
          <p class="stamp" data-board-day>Today's board<br />written at 16:00</p>
        </div>
        <ol class="board">
          {
            specials.map((s, i) => (
              <li class="reveal">
                <span class="idx">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{s.name}</h3>
                </div>
                <div>
                  <p>{s.text}</p>
                  <span class="note">{s.note}</span>
                </div>
                <span class="price" aria-label={`${s.price} dollars`}>${s.price}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- SIGNATURE: stacked photo panels -->
      <section class="sig" aria-labelledby="sig-title">
        <div class="pad sig-intro reveal">
          <p class="chapter-mark">New here?</p>
          <h2 class="chapter-title" id="sig-title">Start with these three.</h2>
        </div>
        <ol class="sig-stack">
          {
            signature.map((d, i) => (
              <li class="sig-panel" style={`--i:${i}`}>
                <article class="sig-card" aria-labelledby={`sig-${d.id}`}>
                  <div class="sig-media" aria-hidden="true">
                    {photos[`plate-${d.id}`] ? (
                      <img src={photos[`plate-${d.id}`]!} alt="" width="1600" height="1067" loading="lazy" />
                    ) : (
                      <div class={`sig-fallback fb-${d.id}`}>
                        <Plate id={d.id} />
                      </div>
                    )}
                  </div>
                  <div class="sig-body">
                    <span class="sig-num">{String(i + 1).padStart(2, "0")} / 03</span>
                    <h3 id={`sig-${d.id}`}>{d.name}</h3>
                    <p>{d.text}</p>
                    <div class="sig-foot">
                      <span class="sig-price" aria-label={`${d.price} dollars`}>${d.price}</span>
                      <button type="button" class="add add-lg" data-add data-name={d.name} data-price={d.price} data-cat={d.id === "kunefe" ? "sweets" : d.id === "adana" ? "mangal" : "meze"} >
                        <Icon name="plus" size={18} /> Add<span class="sr-only"> {d.name}</span> to your sofra
                      </button>
                    </div>
                  </div>
                </article>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- 03 MENU -->
      <section class="chapter menu-ch" id="menu" aria-labelledby="menu-title">
        <div class="pad menu-intro reveal">
          <p class="chapter-mark"><b>03</b> The menu</p>
          <h2 class="chapter-title" id="menu-title">Share everything. Build your sofra.</h2>
          <p class="body">Tap <span class="kbd" aria-hidden="true">+</span> to put dishes on your table, and we'll tell you how many people it feeds. Every dish is tagged; the kitchen adapts most plates for allergies.</p>
        </div>

        <div class="menu-bar" data-menu-bar>
          <div class="pad menu-bar-inner">
            <nav class="cat-pills" aria-label="Menu sections">
              {menu.map((m) => <a href={`#cat-${m.id}`} data-cat-link={m.id}>{m.label}</a>)}
            </nav>
            <div class="filters" role="group" aria-label="Show only dishes that are">
              {
                dietary.map((d) => (
                  <button type="button" class="filter" aria-pressed="false" data-filter={d.id} title={d.label}>
                    <Icon name={tagIcon[d.id]} size={16} />
                    <span>{d.label}</span>
                  </button>
                ))
              }
            </div>
          </div>
        </div>
        <p class="sr-only" aria-live="polite" data-filter-status></p>

        <div class="pad menu-body" data-menu>
          {
            menu.map((m, ci) => (
              <section class="cat" id={`cat-${m.id}`} aria-labelledby={`h-${m.id}`} data-cat={m.id}>
                <header class="cat-head">
                  <span class="cat-n" aria-hidden="true">{String(ci + 1).padStart(2, "0")}</span>
                  <h3 id={`h-${m.id}`} class="cat-word">{m.label}</h3>
                  <p>{m.intro}</p>
                </header>
                <ul class="dishes">
                  {m.items.map((it, j) => (
                    <li class="dish" data-tags={it.tags.join(" ")} data-preview={photos[`cat-${m.id}`] ?? ""} style={`view-transition-name:dish-${m.id}-${j}`}>
                      <div class="dish-name">
                        <h4 lang="tr">{it.tr}</h4>
                        <span class="en">{it.en}</span>
                      </div>
                      <p class="desc">{it.text}</p>
                      <ul class="diet" aria-label="Dietary">
                        {it.tags.map((t) => (
                          <li class={`diet-${t}`} title={tagLabel[t]}>
                            <Icon name={tagIcon[t]} size={15} />
                            <span class="sr-only">{tagLabel[t]}</span>
                          </li>
                        ))}
                      </ul>
                      <span class="dish-price" aria-label={`${it.price} dollars`}>{it.price}</span>
                      <button type="button" class="add" data-add data-name={it.tr} data-price={it.price} data-cat={m.id} aria-label={`Add ${it.tr} to your sofra`}>
                        <Icon name="plus" size={18} />
                      </button>
                    </li>
                  ))}
                </ul>
                <p class="no-match" hidden data-no-match>Nothing in this section matches your filters.</p>
              </section>
            ))
          }
          <p class="pickup"><Icon name="phone" size={18} />Pickup orders: call <a href={brand.phoneHref}>{brand.phone}</a> from 16:30. Ready in about 25 minutes.</p>
        </div>
        <div class="preview" aria-hidden="true" data-preview-box><img alt="" data-preview-img /></div>
      </section>

      <Tile id="tile-k" tone="blue" height={28} />

      <!-- 04 KAHVALTI -->
      <section class="chapter kahvalti" id="kahvalti" aria-labelledby="k-title">
        <div class="pad kahvalti-grid">
          <figure class="arch reveal">
            {photos.kahvalti ? <img src={photos.kahvalti} alt="A table covered with small plates of a Turkish breakfast spread" width="1066" height="1600" loading="lazy" /> : null}
          </figure>
          <div class="reveal">
            <p class="chapter-mark"><b>04</b> Weekend kahvaltı · Sat & Sun 10:00–15:00</p>
            <h2 class="chapter-title" id="k-title">A breakfast that covers the whole table.</h2>
            <p class="body">The Turkish way to spend a slow morning: thirty small plates, eggs in the pan and tea until someone has to leave.</p>
            <p class="k-price"><strong>${kahvalti.price}</strong> per person · for {kahvalti.min} to {kahvalti.max} guests · kids under 10 half price</p>
            <ul class="spread">{kahvalti.spread.map((s) => <li>{s}</li>)}</ul>
            <a class="btn btn-fire" href="#reserve" data-preset-day="weekend">Book weekend kahvaltı <Icon name="arrow" size={18} /></a>
          </div>
        </div>
      </section>

      <!-- 05 MANGAL NIGHTS -->
      <section class="chapter nights" id="mangal-nights" aria-labelledby="n-title">
        <div class="nights-bg" aria-hidden="true">
          {photos.fire ? <img src={photos.fire} alt="" width="1066" height="1600" loading="lazy" /> : <div class="ph"></div>}
        </div>
        <div class="pad nights-grid">
          <div class="reveal">
            <p class="chapter-mark"><b>05</b> Mangal nights · private dining</p>
            <h2 class="chapter-title" id="n-title">The long table is yours, for 8 to 24.</h2>
            <p class="body">Birthdays, team dinners, the night before a wedding. One long table next to the grill, a set menu, and a host who looks after nothing but your group.</p>
            <ul class="sets">
              {
                setMenus.map((s) => (
                  <li class:list={["set", { featured: s.featured }]}>
                    <h3>
                      {s.name}
                      {s.featured && <span class="badge">Most booked</span>}
                    </h3>
                    <span class="pp">${s.price}<small>per guest</small></span>
                    <p>{s.text}</p>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="glass-form reveal" data-inquiry>
            <form novalidate data-inquiry-form>
              <h3>Ask about a mangal night</h3>
              <p>We reply within one working day with a proposal and a deposit link.</p>
              <div class="field">
                <label for="iq-name">Your name</label>
                <input id="iq-name" name="name" autocomplete="name" required />
              </div>
              <div class="row-2">
                <div class="field">
                  <label for="iq-guests">Guests (8–24)</label>
                  <input id="iq-guests" name="guests" type="number" min="8" max="24" inputmode="numeric" value="12" required />
                </div>
                <div class="field">
                  <label for="iq-date">Preferred date</label>
                  <input id="iq-date" name="date" type="date" required />
                </div>
              </div>
              <div class="field">
                <label for="iq-menu">Set menu</label>
                <select id="iq-menu" name="menu">
                  {setMenus.map((s) => <option selected={s.featured}>{s.name} · ${s.price} per guest</option>)}
                  <option>Not sure yet</option>
                </select>
              </div>
              <div class="field">
                <label for="iq-phone">Phone</label>
                <input id="iq-phone" name="phone" type="tel" autocomplete="tel" required />
              </div>
              <div class="field">
                <label for="iq-note">What's the occasion? <small>(optional)</small></label>
                <textarea id="iq-note" name="note"></textarea>
              </div>
              <p class="err" role="alert" data-iq-error></p>
              <button class="btn btn-pom" type="submit">Send inquiry <Icon name="arrow" size={18} /></button>
            </form>
            <div class="sent" hidden tabindex="-1" data-iq-done>
              <div class="ok"><Icon name="check" size={28} /></div>
              <h3>Inquiry received</h3>
              <p data-iq-text></p>
              <p style="margin-top:.75rem;font-size:.85rem">This is a concept site, so nothing was actually sent.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- GUESTS -->
      <section class="guests pad" aria-labelledby="g-title">
        <p class="chapter-mark reveal" id="g-title">Guests say</p>
        <div class="quotes" tabindex="0" aria-label="Guest quotes, scroll sideways">
          {
            quotes.map((q) => (
              <figure>
                <blockquote>{q.quote}</blockquote>
                <figcaption>
                  <strong>{q.name}</strong> · {q.detail}
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <!-- 06 RESERVE -->
      <section class="chapter reserve pad" id="reserve" aria-labelledby="r-title">
        <div class="reserve-head reveal">
          <p class="chapter-mark"><b>06</b> Reserve</p>
          <h2 class="chapter-title" id="r-title">Book a table in under a minute.</h2>
          <p class="body">Tables for 1 to 8. We hold your table for 15 minutes. Running late? Call <a href={brand.phoneHref}>{brand.phone}</a>. 9 or more guests? <a href="#mangal-nights">Plan a mangal night</a> instead.</p>
        </div>

        <div class="stage">
          <div class="book" data-book>
            <form novalidate data-book-form>
              <fieldset>
                <legend>Guests</legend>
                <div class="chips">
                  {
                    [1, 2, 3, 4, 5, 6, 7, 8].map((n) => (
                      <div class="chip">
                        <input type="radio" name="guests" id={`g-${n}`} value={n} checked={n === 2} />
                        <label for={`g-${n}`}>{n}</label>
                      </div>
                    ))
                  }
                </div>
              </fieldset>
              <fieldset>
                <legend>Day</legend>
                <div class="chips" data-days><noscript><p class="hint">Online booking needs JavaScript. Please call us.</p></noscript></div>
              </fieldset>
              <fieldset>
                <legend>Time</legend>
                <div class="chips" data-times><p class="hint">Pick a day to see free times.</p></div>
              </fieldset>
              <div class="row-2">
                <div class="field">
                  <label for="bk-name">Name</label>
                  <input id="bk-name" name="name" autocomplete="name" required />
                </div>
                <div class="field">
                  <label for="bk-phone">Phone <small>(optional)</small></label>
                  <input id="bk-phone" name="phone" type="tel" autocomplete="tel" />
                </div>
              </div>
              <div class="field">
                <label for="bk-note">Allergies or a special occasion? <small>(optional)</small></label>
                <input id="bk-note" name="note" />
              </div>
              <p class="err" role="alert" data-bk-error></p>
              <button class="btn btn-pom" type="submit">Confirm the table <Icon name="arrow" size={18} /></button>
            </form>
            <div class="sent" hidden tabindex="-1" data-bk-done>
              <div class="ok"><Icon name="check" size={28} /></div>
              <h3>Table requested</h3>
              <p data-bk-text></p>
              <p style="margin-top:.75rem;font-size:.85rem">This is a concept site, so no booking was actually made.</p>
            </div>
          </div>

          <aside class="receipt" aria-label="Your booking summary" aria-live="polite">
            <p class="r-brand">SUMAKARA <span>ADİSYON № 0187</span></p>
            <dl>
              <dt>Guests</dt><dd data-r-guests>2</dd>
              <dt>Day</dt><dd data-r-day>—</dd>
              <dt>Time</dt><dd data-r-time>—</dd>
              <dt>Name</dt><dd data-r-name>—</dd>
              <dt>Sofra</dt><dd data-r-sofra>—</dd>
            </dl>
            <p class="r-total"><span>TOTAL</span><span>ONE GOOD EVENING</span></p>
            <p class="r-foot">Tea is on the house.</p>
          </aside>
        </div>
      </section>

      <!-- VISIT + FAQ -->
      <section class="visit pad" id="visit" aria-labelledby="v-title">
        <h2 class="sr-only" id="v-title">Visit Sumakara</h2>
        <div class="visit-strip">
          <div class="reveal">
            <h3><Icon name="pin" size={20} />Find us</h3>
            <p>{brand.address[0]}<br />{brand.address[1]}</p>
            <p style="margin-top:.5rem;color:var(--ink-soft)">Follow the smell of charcoal: two minutes from the Halvern Square tram stop, bike racks out front.</p>
            <a class="directions" href="#visit"><Icon name="route" size={18} />Directions</a>
          </div>
          <div class="reveal">
            <h3><Icon name="clock" size={20} />Opening hours</h3>
            <ul class="hours-list" data-hours>
              {
                hours.map((h) => (
                  <li data-day={h.day}>
                    <span>{h.label}</span>
                    <span>{h.services.length ? fmtHours(h.services) : "Closed"}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="reveal">
            <h3><Icon name="phone" size={20} />Call or drop by</h3>
            <p><a href={brand.phoneHref}><strong>{brand.phone}</strong></a></p>
            <p style="margin-top:.5rem;color:var(--ink-soft)">Step-free entrance and an accessible restroom. High chairs on request. Kitchen closes 30 minutes before we do.</p>
          </div>
        </div>

        <div class="faq">
          <h2 class="reveal">Good to know.</h2>
          <div class="reveal">
            {
              faq.map((f) => (
                <details name="faq">
                  <summary>
                    {f.q}
                    <Icon name="plus" size={20} />
                  </summary>
                  <p>{f.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <Tile id="tile-f" tone="dark" height={28} />
      <p class="footer-word" aria-hidden="true">Sumakara</p>
      <div class="pad">
        <div class="footer-grid">
          <p>{brand.address.join(", ")} · <a href={brand.phoneHref}>{brand.phone}</a></p>
          <ul>
            {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            <li><a href="#reserve">Reserve</a></li>
          </ul>
        </div>
        <p class="fine">
          © 2026 Sumakara is a fictional restaurant created as a design concept. Names, people, prices, address and
          phone number are invented. Fonts: Anybody and Instrument Sans (SIL Open Font License). Illustrations made for
          this concept.{anyPhoto && " Photos: Unsplash and Pexels."} <a href="/">More concepts</a>
        </p>
      </div>
    </footer>

    <aside class="dock" aria-label="Your sofra" data-dock hidden>
      <div class="dock-inner">
        <button type="button" class="dock-toggle" aria-expanded="false" aria-controls="dock-list" data-dock-toggle>
          <span class="dock-count" data-dock-count>0</span>
          <span class="dock-text"><strong>Your sofra</strong><span data-dock-hint>Add a few meze to start</span></span>
        </button>
        <span class="dock-total" data-dock-total>$0</span>
        <button type="button" class="btn btn-fire dock-cta" data-dock-book>Book with this sofra</button>
      </div>
      <div class="dock-list" id="dock-list" hidden data-dock-list>
        <ul data-dock-items></ul>
        <button type="button" class="dock-clear" data-dock-clear>Clear the table</button>
      </div>
      <p class="sr-only" aria-live="polite" data-dock-live></p>
    </aside>

    <a class="btn btn-pom float-cta" href="#reserve" data-float-cta>Reserve <Icon name="arrow" size={18} /></a>
  </div>
</Base>

<script>
  import { hours } from "../../concepts/restaurant/content.js";

  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s);
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll<T>(s)];
  const toMin = (t: string) => {
    const [h, m] = t.split(":").map(Number);
    return h * 60 + m;
  };
  const now = new Date();
  const today = hours.find((h) => h.day === now.getDay());

  // Header: transparent over the hero, solid after it. Floating Reserve after the hero.
  const header = $("[data-header]");
  const floatCta = $("[data-float-cta]");
  const reserve = $("#reserve");
  const onScroll = () => {
    const past = window.scrollY > window.innerHeight * 0.75;
    header?.classList.toggle("solid", window.scrollY > window.innerHeight - 80);
    const rr = reserve?.getBoundingClientRect();
    const atReserve = rr ? rr.top < window.innerHeight && rr.bottom > 0 : false;
    const dockOpen = !document.querySelector("[data-dock]")?.hasAttribute("hidden");
    floatCta?.classList.toggle("show", past && !atReserve && !dockOpen);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Mobile menu
  const toggle = $<HTMLButtonElement>("[data-menu-toggle]");
  const mmenu = $("#mobile-menu");
  const setMenu = (open: boolean) => {
    if (!toggle || !mmenu) return;
    toggle.setAttribute("aria-expanded", String(open));
    mmenu.dataset.open = String(open);
    toggle.querySelector("[data-icon-open]")?.toggleAttribute("hidden", open);
    toggle.querySelector("[data-icon-close]")?.toggleAttribute("hidden", !open);
    document.body.style.overflow = open ? "hidden" : "";
  };
  toggle?.addEventListener("click", () => setMenu(toggle.getAttribute("aria-expanded") !== "true"));
  $$("[data-menu-link]").forEach((a) => a.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (e) => e.key === "Escape" && setMenu(false));

  // Open now + today's hours (visitor's local clock: demo behaviour)
  const pill = $("[data-open-pill]");
  const pillText = $("[data-open-text]");
  const mins = now.getHours() * 60 + now.getMinutes();
  if (today && pill && pillText) {
    const open = today.services.find(([a, b]) => mins >= toMin(a) && mins < toMin(b));
    pill.dataset.state = open ? "open" : "closed";
    pillText.textContent = open
      ? `Open now · kitchen closes ${(() => { const k = toMin(open[1]) - 30; return `${String(Math.floor(k / 60)).padStart(2, "0")}:${String(k % 60).padStart(2, "0")}`; })()}`
      : today.services.length
        ? `Closed now · opens ${today.services.find(([a]) => mins < toMin(a))?.[0] ?? "tomorrow"}`
        : "Closed today · back tomorrow";
  }
  const todayHours = $("[data-today-hours]");
  if (todayHours && today) todayHours.textContent = today.services.length ? today.services.map(([a, b]) => `${a}–${b}`).join(" · ") : "Closed today";
  $(`[data-hours] li[data-day="${now.getDay()}"]`)?.classList.add("is-today");

  // Menu: highlight the category in view
  const catLinks = $$<HTMLAnchorElement>("[data-cat-link]");
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        const id = (en.target as HTMLElement).dataset.cat;
        catLinks.forEach((a) => a.setAttribute("aria-current", String(a.dataset.catLink === id)));
        const active = catLinks.find((a) => a.dataset.catLink === id);
        active?.scrollIntoView({ block: "nearest", inline: "nearest" });
      });
    },
    { rootMargin: "-35% 0px -60% 0px" },
  );
  $$("[data-cat]").forEach((s) => io.observe(s));

  // Menu: dietary filters (AND), animated with the View Transitions API when available
  const active = new Set<string>();
  const status = $("[data-filter-status]");
  const applyFilters = () => {
    let shown = 0;
    $$("[data-cat]").forEach((cat) => {
      let inCat = 0;
      $$<HTMLElement>(".dish", cat).forEach((d) => {
        const tags = (d.dataset.tags ?? "").split(" ");
        const ok = [...active].every((t) => tags.includes(t));
        d.hidden = !ok;
        if (ok) inCat++;
      });
      shown += inCat;
      const nm = $("[data-no-match]", cat);
      if (nm) nm.hidden = inCat > 0;
    });
    if (status) status.textContent = active.size ? `${shown} dishes match` : "";
  };
  $$<HTMLButtonElement>("[data-filter]").forEach((b) =>
    b.addEventListener("click", () => {
      const id = b.dataset.filter!;
      const on = b.getAttribute("aria-pressed") !== "true";
      b.setAttribute("aria-pressed", String(on));
      on ? active.add(id) : active.delete(id);
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      // @ts-ignore: startViewTransition is not in every lib.dom version yet
      if (document.startViewTransition && !reduce) document.startViewTransition(applyFilters);
      else applyFilters();
    }),
  );

  // Reservation: days (Mondays closed), times from opening hours, live receipt
  const daysBox = $("[data-days]");
  const timesBox = $("[data-times]");
  const fmtDay = new Intl.DateTimeFormat("en-US", { weekday: "short" });
  const fmtDate = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" });
  const dayInfo = new Map<string, { label: string; dow: number }>();
  if (daysBox) {
    for (let i = 0; i < 8; i++) {
      const d = new Date(now);
      d.setDate(now.getDate() + i);
      const dow = d.getDay();
      const h = hours.find((x) => x.day === dow);
      const closed = !h || h.services.length === 0;
      const label = i === 0 ? "Today" : i === 1 ? "Tomorrow" : fmtDay.format(d);
      const id = `day-${i}`;
      dayInfo.set(id, { label: `${label}, ${fmtDate.format(d)}`, dow });
      const wrap = document.createElement("div");
      wrap.className = "chip";
      wrap.innerHTML = `<input type="radio" name="day" id="${id}" value="${id}" ${closed ? "disabled" : ""}><label for="${id}">${label}<small>${closed ? "Closed" : fmtDate.format(d)}</small></label>`;
      daysBox.appendChild(wrap);
    }
  }
  const renderTimes = (dayId: string) => {
    if (!timesBox) return;
    const info = dayInfo.get(dayId);
    const h = hours.find((x) => x.day === info?.dow);
    timesBox.innerHTML = "";
    const slots: string[] = [];
    h?.services.forEach(([a, b]) => {
      for (let t = toMin(a); t <= toMin(b) - 90; t += 30) slots.push(`${String(Math.floor(t / 60)).padStart(2, "0")}:${String(t % 60).padStart(2, "0")}`);
    });
    const isToday = dayId === "day-0";
    slots.forEach((s, i) => {
      const past = isToday && toMin(s) <= mins + 30;
      const wrap = document.createElement("div");
      wrap.className = "chip";
      wrap.innerHTML = `<input type="radio" name="time" id="t-${i}" value="${s}" ${past ? "disabled" : ""}><label for="t-${i}">${s}</label>`;
      timesBox.appendChild(wrap);
    });
    if (!slots.length) timesBox.innerHTML = `<p class="hint">No tables that day.</p>`;
  };

  const form = $<HTMLFormElement>("[data-book-form]");
  const val = (n: string) => form?.querySelector<HTMLInputElement>(`[name="${n}"]:checked`)?.value ?? "";
  const r = (k: string, v: string) => {
    const el = $(`[data-r-${k}]`);
    if (el) el.textContent = v || "—";
  };
  form?.addEventListener("change", (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === "day") renderTimes(t.value);
    r("guests", val("guests"));
    r("day", dayInfo.get(val("day"))?.label ?? "");
    r("time", val("time"));
  });
  form?.querySelector<HTMLInputElement>("#bk-name")?.addEventListener("input", (e) => r("name", (e.target as HTMLInputElement).value.trim()));
  // "Book weekend kahvaltı" preselects the next Saturday/Sunday
  $$("[data-preset-day]").forEach((a) =>
    a.addEventListener("click", () => {
      const id = [...dayInfo.entries()].find(([k, v]) => (v.dow === 6 || v.dow === 0) && !($(`#${k}`) as HTMLInputElement)?.disabled)?.[0];
      const input = id ? $<HTMLInputElement>(`#${id}`) : null;
      if (input) {
        input.checked = true;
        input.dispatchEvent(new Event("change", { bubbles: true }));
      }
    }),
  );
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const err = $("[data-bk-error]");
    const name = form.querySelector<HTMLInputElement>("#bk-name");
    const missing = [!val("day") && "a day", !val("time") && "a time", !name?.value.trim() && "your name"].filter(Boolean) as string[];
    name?.setAttribute("aria-invalid", String(!name.value.trim()));
    if (missing.length) {
      if (err) err.textContent = `Please choose ${missing.join(", ").replace(/, ([^,]*)$/, " and $1")}.`;
      return;
    }
    if (err) err.textContent = "";
    form.hidden = true;
    const done = $("[data-bk-done]");
    const txt = $("[data-bk-text]");
    if (txt) txt.textContent = `${val("guests")} ${val("guests") === "1" ? "guest" : "guests"}, ${dayInfo.get(val("day"))?.label} at ${val("time")}. See you by the fire, ${name!.value.trim()}.`;
    if (done) {
      done.hidden = false;
      done.focus();
    }
  });

  // Menu: photo preview that follows the cursor (desktop, category photos only)
  const box = $("[data-preview-box]");
  const pimg = $<HTMLImageElement>("[data-preview-img]");
  const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
  if (fine && box && pimg) {
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
    const loop = () => {
      x += (tx - x) * 0.18;
      y += (ty - y) * 0.18;
      box.style.transform = `translate(${x}px, ${y}px)`;
      raf = requestAnimationFrame(loop);
    };
    $$<HTMLElement>(".dish").forEach((d) => {
      d.addEventListener("mouseenter", () => {
        const src = d.dataset.preview;
        if (!src) return;
        if (pimg.getAttribute("src") !== src) pimg.src = src;
        box.classList.add("on");
        if (!raf) raf = requestAnimationFrame(loop);
      });
      d.addEventListener("mouseleave", () => box.classList.remove("on"));
      d.addEventListener("mousemove", (e) => {
        tx = e.clientX + 24;
        ty = e.clientY - 90;
      });
    });
  }

  // Sofra builder: add dishes, see how many people it feeds, book with it
  type Line = { name: string; price: number; cat: string; qty: number };
  const sofra = new Map<string, Line>();
  const dock = $("[data-dock]");
  const dockList = $("[data-dock-list]");
  const dockToggle = $<HTMLButtonElement>("[data-dock-toggle]");
  const live = $("[data-dock-live]");
  const feeds = () => {
    let meze = 0, mains = 0;
    sofra.forEach((l) => {
      if (l.cat === "meze" || l.cat === "pide") meze += l.qty;
      if (l.cat === "mangal") mains += l.qty;
    });
    const people = Math.max(mains, Math.round(meze / 2));
    if (!meze && !mains) return "Sweets and drinks only";
    if (mains === 0) return `Meze for about ${Math.max(1, people)} · add a skewer`;
    if (meze < mains) return `Feeds ${people} · add a meze or two`;
    return `Feeds about ${people} ${people === 1 ? "person" : "people"}`;
  };
  const renderSofra = () => {
    let count = 0, total = 0;
    sofra.forEach((l) => {
      count += l.qty;
      total += l.qty * l.price;
    });
    if (dock) dock.hidden = count === 0;
    const set = (sel: string, v: string) => {
      const el = $(sel);
      if (el) el.textContent = v;
    };
    set("[data-dock-count]", String(count));
    set("[data-dock-total]", `$${total}`);
    set("[data-dock-hint]", count ? feeds() : "Add a few meze to start");
    const items = $("[data-dock-items]");
    if (items) {
      items.innerHTML = "";
      sofra.forEach((l, key) => {
        const li = document.createElement("li");
        li.innerHTML = `<span>${l.qty} × ${l.name}</span><span>$${l.qty * l.price}</span>`;
        const rm = document.createElement("button");
        rm.type = "button";
        rm.textContent = "−";
        rm.setAttribute("aria-label", `Remove one ${l.name}`);
        rm.addEventListener("click", () => {
          l.qty -= 1;
          if (l.qty <= 0) sofra.delete(key);
          renderSofra();
        });
        li.appendChild(rm);
        items.appendChild(li);
      });
    }
    $$<HTMLButtonElement>("[data-add]").forEach((b) => {
      const q = sofra.get(b.dataset.name!)?.qty ?? 0;
      b.classList.toggle("added", q > 0);
      b.dataset.qty = q ? String(q) : "";
    });
    const rs = $("[data-r-sofra]");
    if (rs) rs.textContent = count ? `${count} dishes · $${total}` : "—";
    if (!count && dockList) {
      dockList.hidden = true;
      dockToggle?.setAttribute("aria-expanded", "false");
    }
    onScroll();
  };
  $$<HTMLButtonElement>("[data-add]").forEach((b) =>
    b.addEventListener("click", () => {
      const name = b.dataset.name!;
      const line = sofra.get(name) ?? { name, price: Number(b.dataset.price), cat: b.dataset.cat ?? "", qty: 0 };
      line.qty += 1;
      sofra.set(name, line);
      renderSofra();
      if (live) live.textContent = `${name} added. ${feeds()}.`;
      b.animate?.([{ transform: "scale(1)" }, { transform: "scale(1.18)" }, { transform: "scale(1)" }], { duration: 320 });
    }),
  );
  dockToggle?.addEventListener("click", () => {
    const open = dockToggle.getAttribute("aria-expanded") !== "true";
    dockToggle.setAttribute("aria-expanded", String(open));
    if (dockList) dockList.hidden = !open;
  });
  $("[data-dock-clear]")?.addEventListener("click", () => {
    sofra.clear();
    renderSofra();
  });
  $("[data-dock-book]")?.addEventListener("click", () => {
    const note = $<HTMLInputElement>("#bk-note");
    if (note) {
      const list = [...sofra.values()].map((l) => `${l.qty}× ${l.name}`).join(", ");
      note.value = `Sofra: ${list}`;
    }
    $("#reserve")?.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
  });

  // Mangal nights inquiry (demo, nothing sent)
  const iq = $<HTMLFormElement>("[data-inquiry-form]");
  iq?.addEventListener("submit", (e) => {
    e.preventDefault();
    const err = $("[data-iq-error]");
    const get = (id: string) => iq.querySelector<HTMLInputElement>(id)!;
    const name = get("#iq-name"), guests = get("#iq-guests"), date = get("#iq-date"), phone = get("#iq-phone");
    const g = Number(guests.value);
    const problems: string[] = [];
    [name, date, phone].forEach((f) => f.setAttribute("aria-invalid", String(!f.value.trim())));
    if (!name.value.trim()) problems.push("your name");
    if (!(g >= 8 && g <= 24)) problems.push("8 to 24 guests");
    if (!date.value) problems.push("a date");
    if (!phone.value.trim()) problems.push("a phone number");
    guests.setAttribute("aria-invalid", String(!(g >= 8 && g <= 24)));
    if (problems.length) {
      if (err) err.textContent = `Please add ${problems.join(", ").replace(/, ([^,]*)$/, " and $1")}.`;
      return;
    }
    iq.hidden = true;
    const done = $("[data-iq-done]");
    const txt = $("[data-iq-text]");
    if (txt) txt.textContent = `${g} guests on ${date.value}. We'll call ${name.value.trim()} within one working day.`;
    if (done) {
      done.hidden = false;
      done.focus();
    }
  });
</script>
