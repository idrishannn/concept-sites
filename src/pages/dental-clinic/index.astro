---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/figtree";
import Base from "../../layouts/Base.astro";
import Icon from "../../concepts/dental-clinic/Icon.astro";
import "../../concepts/dental-clinic/styles.css";
import {
  brand,
  nav,
  reassurance,
  needs,
  calm,
  prices,
  membership,
  steps,
  team,
  stories,
  bookingReasons,
  hours,
  faq,
} from "../../concepts/dental-clinic/content.js";

const title = "Tessaly Dental Studio · Calm, upfront dentistry in Portland (concept)";
const description =
  "Concept website for a fictional dental studio: problem-first treatments, transparent prices, care for nervous patients and online booking.";
---

<Base {title} {description} ogImage="/og/dental-clinic.png" themeColor="#fbf7f1">
  <div class="c-dental">
    <header class="site-header" data-header>
      <div class="wrap header-inner">
        <a href="#top" class="logo">
          <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true">
            <rect width="34" height="34" rx="11" fill="var(--spruce-900)"></rect>
            <path d="M9 13c0-3 2-4.5 4-4.5 1.8 0 2.6 1 4 1s2.2-1 4-1c2 0 4 1.5 4 4.5 0 4-1.6 12.5-4 12.5-2 0-1.8-6-4-6s-2 6-4 6c-2.4 0-4-8.5-4-12.5z" fill="var(--peach-500)"></path>
          </svg>
          <span>{brand.name}<small>Dental Studio</small></span>
        </a>
        <nav class="main-nav" aria-label="Main">
          <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
        </nav>
        <div class="header-actions">
          <a class="header-phone" href={brand.phoneHref}><Icon name="phone" size={18} />{brand.phone}</a>
          <a class="btn btn-primary" href="#book">Book a visit</a>
        </div>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
          <span class="sr-only">Menu</span>
          <span data-icon-open><Icon name="menu" size={22} /></span>
          <span data-icon-close hidden><Icon name="close" size={22} /></span>
        </button>
      </div>
      <div class="mobile-menu" id="mobile-menu" data-open="false">
        <ul>{nav.map((n) => <li><a href={n.href} data-menu-link>{n.label}</a></li>)}</ul>
        <a class="btn btn-primary" href="#book" data-menu-link style="width:100%">Book a visit</a>
      </div>
    </header>

    <main id="main">
      <span id="top"></span>
      <!-- Hero -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="wrap hero-grid">
          <div>
            <p class="eyebrow">Dental studio · Portland</p>
            <h1 id="hero-title">
              Dentistry that feels like a{" "}<em>deep breath.<svg viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"><path d="M2 9c40-6 80-7 196-3" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"></path></svg></em>
            </h1>
            <p class="lead">
              Gentle, unhurried care for adults and families. You'll know every step and every price before we
              start, and you can stop us at any moment.
            </p>
            <div class="hero-ctas">
              <a class="btn btn-primary" href="#book">Book a visit <Icon name="arrow" size={18} /></a>
              <a class="btn btn-ghost" href="#prices">See our prices</a>
            </div>
            <ul class="reassure">
              {reassurance.map((r) => <li><span class="tick"><Icon name="check" size={16} /></span>{r}</li>)}
            </ul>
          </div>

          <div class="hero-art" aria-hidden="true">
            <div class="arch">
              <svg viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice">
                <defs>
                  <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#cddccf"></stop>
                    <stop offset="1" stop-color="#e9dccb"></stop>
                  </linearGradient>
                </defs>
                <rect width="400" height="500" fill="url(#sky)"></rect>
                <circle class="float slow" cx="290" cy="120" r="54" fill="#fbe4d8"></circle>
                <g class="float">
                  <path d="M118 210c0-42 26-62 54-62 24 0 34 12 52 12s28-12 52-12c28 0 54 20 54 62 0 54-22 170-54 170-26 0-24-80-52-80s-26 80-52 80c-32 0-54-116-54-170z" fill="#fbf7f1"></path>
                  <path d="M150 200c8-18 22-26 38-24" fill="none" stroke="#e8875f" stroke-width="7" stroke-linecap="round"></path>
                </g>
                <path d="M0 430c70-30 140-30 200 0s130 30 200 0v70H0z" fill="#3d6e6a" opacity=".9"></path>
                <path d="M0 455c70-25 140-25 200 0s130 25 200 0v45H0z" fill="#12302f"></path>
              </svg>
            </div>
          </div>
        </div>
      </section>

      <!-- Needs -->
      <section class="needs" id="treatments" aria-labelledby="needs-title">
        <div class="wrap">
          <div class="section-head reveal">
            <div>
              <p class="eyebrow">Treatments</p>
              <h2 class="h2" id="needs-title">What brings you in?</h2>
            </div>
            <p class="lead">Start with what you're feeling. We'll take care of the clinical words.</p>
          </div>
          <ul class="needs-grid" role="list">
            {
              needs.map((n) => (
                <li class="need reveal">
                  <a href="#book" data-reason={n.target}>
                    <span class="icon"><Icon name={n.icon} /></span>
                    <h3>{n.title}</h3>
                    <p>{n.text}</p>
                    <span class="from">
                      <span>From</span>
                      {n.from}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Calm -->
      <section class="calm" aria-labelledby="calm-title">
        <div class="wrap calm-grid">
          <div class="reveal">
            <p class="eyebrow">For nervous patients</p>
            <h2 class="h2" id="calm-title">Anxious about the dentist? So were most of our patients.</h2>
            <p class="lead">
              We built the studio around the people who'd rather be anywhere else. Quiet rooms, no rush, and a
              team that explains before it acts.
            </p>
          </div>
          <ul class="calm-list" role="list">
            {calm.map((c) => <li class="reveal"><h3>{c.title}</h3><p>{c.text}</p></li>)}
          </ul>
        </div>
      </section>

      <!-- Prices -->
      <section id="prices" aria-labelledby="prices-title">
        <div class="wrap">
          <div class="section-head reveal">
            <div>
              <p class="eyebrow">Prices</p>
              <h2 class="h2" id="prices-title">Clear prices, before anything starts.</h2>
            </div>
            <p class="lead">Typical self-pay prices. Your written plan shows your exact cost, with or without insurance.</p>
          </div>
          <div class="prices-grid">
            <div class="reveal">
              <ul class="price-list" role="list">
                {prices.map((p) => <li><span>{p.item}</span><strong>{p.price}</strong></li>)}
              </ul>
              <p class="price-note">We work with most PPO dental plans and file claims for you. Interest-free payment plans for treatments over $500.</p>
            </div>
            <aside class="membership reveal" aria-labelledby="membership-title">
              <span class="badge">No insurance? No problem.</span>
              <h3 id="membership-title">{membership.name}</h3>
              <p class="amount">{membership.price} <span>{membership.per}</span></p>
              <ul role="list">{membership.perks.map((p) => <li><Icon name="check" size={18} />{p}</li>)}</ul>
              <a class="btn btn-primary" href="#book">Join at your first visit</a>
            </aside>
          </div>
        </div>
      </section>

      <!-- First visit -->
      <section class="first-visit" id="first-visit" aria-labelledby="steps-title">
        <div class="wrap">
          <div class="section-head reveal">
            <div>
              <p class="eyebrow">Your first visit</p>
              <h2 class="h2" id="steps-title">Here's exactly what happens.</h2>
            </div>
            <p class="lead">No surprises, from the moment you book to the moment you decide.</p>
          </div>
          <ol class="steps">
            {steps.map((s) => <li class="reveal"><span class="n" aria-hidden="true">{s.n}</span><h3>{s.title}</h3><p>{s.text}</p></li>)}
          </ol>
        </div>
      </section>

      <!-- Team -->
      <section id="team" aria-labelledby="team-title">
        <div class="wrap">
          <div class="section-head reveal">
            <div>
              <p class="eyebrow">Our team</p>
              <h2 class="h2" id="team-title">The people who'll look after you.</h2>
            </div>
          </div>
          <ul class="team-grid" role="list">
            {
              team.map((p) => (
                <li class="person reveal">
                  <div class="avatar" aria-hidden="true">{p.initials}</div>
                  <h3>{p.name}</h3>
                  <p class="role">{p.role}</p>
                  <p>{p.note}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Stories -->
      <section class="stories" aria-labelledby="stories-title">
        <div class="wrap">
          <div class="section-head reveal">
            <div>
              <p class="eyebrow">Patient stories</p>
              <h2 class="h2" id="stories-title">In their words.</h2>
            </div>
          </div>
          <ul class="story-grid" role="list">
            {
              stories.map((s) => (
                <li class="story reveal">
                  <blockquote>“{s.quote}”</blockquote>
                  <footer><strong>{s.name}</strong> · {s.detail}</footer>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Booking -->
      <section id="book" aria-labelledby="book-title">
        <div class="wrap booking-wrap">
          <div class="reveal">
            <p class="eyebrow">Book a visit</p>
            <h2 class="h2" id="book-title">Pick a time that suits you.</h2>
            <p class="lead">Three quick choices. We'll text you to confirm, usually within the hour.</p>
            <p class="lead">Prefer to talk? Call <a href={brand.phoneHref}><strong>{brand.phone}</strong></a>.</p>
          </div>

          <div class="booking" data-booking>
            <form data-booking-form novalidate>
              <fieldset>
                <legend><span>1</span>What's the visit for?</legend>
                <div class="chips">
                  {
                    bookingReasons.map((r) => (
                      <div class="chip">
                        <input type="radio" name="reason" id={`r-${r.id}`} value={r.label} data-reason-input={r.id} />
                        <label for={`r-${r.id}`}>{r.label}</label>
                      </div>
                    ))
                  }
                </div>
              </fieldset>
              <fieldset>
                <legend><span>2</span>Which day?</legend>
                <div class="chips" data-days>
                  <noscript><p>Online booking needs JavaScript. Please call us instead.</p></noscript>
                </div>
              </fieldset>
              <fieldset>
                <legend><span>3</span>What time?</legend>
                <div class="chips">
                  {
                    ["8:30", "10:00", "11:30", "14:00", "16:30", "18:00"].map((t) => (
                      <div class="chip">
                        <input type="radio" name="time" id={`t-${t.replace(":", "")}`} value={t} />
                        <label for={`t-${t.replace(":", "")}`}>{t}</label>
                      </div>
                    ))
                  }
                </div>
              </fieldset>
              <div class="booking-summary">
                <p data-summary aria-live="polite">Choose a reason, a day and a time.</p>
                <button class="btn btn-primary" type="submit">Request this time <Icon name="arrow" size={18} /></button>
              </div>
              <p class="booking-error" data-error role="alert"></p>
            </form>
            <div class="booking-done" data-done hidden tabindex="-1">
              <div class="ok"><Icon name="check" size={30} /></div>
              <h3>Request received</h3>
              <p data-done-text></p>
              <p style="margin-top:.75rem;font-size:.875rem">This is a concept site, so no request was actually sent.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Visit -->
      <section class="visit" id="visit" aria-labelledby="visit-title">
        <div class="wrap">
          <div class="section-head reveal">
            <div>
              <p class="eyebrow">Visit us</p>
              <h2 class="h2" id="visit-title">Easy to find, easy to park.</h2>
            </div>
          </div>
          <div class="visit-grid">
            <div class="visit-info reveal">
              <div class="info-block">
                <span class="ic"><Icon name="pin" /></span>
                <div>
                  <h3>Address</h3>
                  <p>{brand.address[0]}<br />{brand.address[1]}</p>
                  <p style="margin-top:.35rem;color:var(--ink-soft)">Free parking behind the building · 3 min from the Alder St streetcar stop</p>
                </div>
              </div>
              <div class="info-block">
                <span class="ic"><Icon name="clock" /></span>
                <div>
                  <h3>Opening hours</h3>
                  <dl class="hours">{hours.map(([d, h]) => <><dt>{d}</dt><dd>{h}</dd></>)}</dl>
                </div>
              </div>
              <div class="info-block">
                <span class="ic"><Icon name="phone" /></span>
                <div>
                  <h3>Contact</h3>
                  <p><a href={brand.phoneHref}>{brand.phone}</a><br /><a href={`mailto:${brand.email}`}>{brand.email}</a></p>
                </div>
              </div>
            </div>
            <div class="map reveal" role="img" aria-label="Illustrated map showing the studio on Alder Street, near the streetcar stop and parking">
              <svg viewBox="0 0 600 440" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                <rect width="600" height="440" fill="#e3ebe3"></rect>
                <path d="M-20 300 620 230" stroke="#fbf7f1" stroke-width="34"></path>
                <path d="M210 -20 290 460" stroke="#fbf7f1" stroke-width="26"></path>
                <path d="M420 -20 470 460" stroke="#fbf7f1" stroke-width="18"></path>
                <path d="M-20 120 620 80" stroke="#fbf7f1" stroke-width="18"></path>
                <path d="M-20 300 620 230" stroke="#cddccf" stroke-width="3" stroke-dasharray="10 10"></path>
                <rect x="40" y="150" width="140" height="110" rx="14" fill="#cddccf"></rect>
                <rect x="320" y="120" width="80" height="80" rx="12" fill="#e9dccb"></rect>
                <rect x="490" y="280" width="90" height="120" rx="14" fill="#cddccf"></rect>
                <rect x="310" y="300" width="120" height="90" rx="14" fill="#e9dccb"></rect>
                <text x="330" y="355" font-family="Figtree Variable, sans-serif" font-size="16" font-weight="600" fill="#44605e">P</text>
                <circle cx="150" cy="292" r="9" fill="#3d6e6a"></circle>
                <g class="float">
                  <path d="M262 214c0-22 16-36 34-36s34 14 34 36c0 26-34 56-34 56s-34-30-34-56z" fill="#c9643d"></path>
                  <circle cx="296" cy="214" r="11" fill="#fbf7f1"></circle>
                </g>
                <text x="340" y="190" font-family="Bricolage Grotesque Variable, sans-serif" font-size="20" font-weight="700" fill="#12302f">Tessaly</text>
                <text x="70" y="330" font-family="Figtree Variable, sans-serif" font-size="13" fill="#44605e">Streetcar</text>
              </svg>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section aria-labelledby="faq-title">
        <div class="wrap faq-grid">
          <div class="reveal">
            <p class="eyebrow">Questions</p>
            <h2 class="h2" id="faq-title">Good to know.</h2>
            <p class="lead">Still unsure about something? Call us. Sam will happily talk it through.</p>
          </div>
          <div class="reveal">
            {
              faq.map((f) => (
                <details>
                  <summary>
                    {f.q}
                    <span class="pm" aria-hidden="true"><Icon name="plus" size={16} /></span>
                  </summary>
                  <p>{f.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a href="#top" class="logo" style="font-size:1.2rem">{brand.full}</a>
            <p style="margin-top:.5rem">{brand.address.join(", ")} · <a href={brand.phoneHref}>{brand.phone}</a></p>
          </div>
          <ul>
            {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            <li><a href="#book">Book</a></li>
          </ul>
        </div>
        <p class="fictional">
          © 2026 Tessaly Dental Studio is a fictional business created as a design concept. Names, people, prices,
          address and phone number are invented. <a href="/">More concepts</a>
        </p>
      </div>
    </footer>

    <div class="action-bar" aria-label="Quick actions">
      <a class="btn btn-ghost" href={brand.phoneHref}><Icon name="phone" size={18} />Call</a>
      <a class="btn btn-primary" href="#book">Book a visit</a>
    </div>
  </div>
</Base>

<style is:global>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  // Header border on scroll
  const header = document.querySelector<HTMLElement>("[data-header]");
  const onScroll = () => header?.classList.toggle("scrolled", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Mobile menu
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");
  const setMenu = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute("aria-expanded", String(open));
    menu.dataset.open = String(open);
    toggle.querySelector("[data-icon-open]")?.toggleAttribute("hidden", open);
    toggle.querySelector("[data-icon-close]")?.toggleAttribute("hidden", !open);
    document.body.style.overflow = open ? "hidden" : "";
  };
  toggle?.addEventListener("click", () => setMenu(toggle.getAttribute("aria-expanded") !== "true"));
  document.querySelectorAll("[data-menu-link]").forEach((a) => a.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (e) => e.key === "Escape" && setMenu(false));

  // Booking widget (demo: nothing is sent)
  const form = document.querySelector<HTMLFormElement>("[data-booking-form]");
  const daysBox = document.querySelector<HTMLElement>("[data-days]");
  const summary = document.querySelector<HTMLElement>("[data-summary]");
  const errorBox = document.querySelector<HTMLElement>("[data-error]");
  const done = document.querySelector<HTMLElement>("[data-done]");
  const doneText = document.querySelector<HTMLElement>("[data-done-text]");

  if (daysBox) {
    const fmtDay = new Intl.DateTimeFormat("en-US", { weekday: "short" });
    const fmtDate = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" });
    const today = new Date();
    let added = 0;
    for (let i = 0; added < 6 && i < 10; i++) {
      const d = new Date(today);
      d.setDate(today.getDate() + i);
      if (d.getDay() === 0) continue; // closed Sundays
      const id = `d-${i}`;
      const label = i === 0 ? "Today" : i === 1 ? "Tomorrow" : fmtDay.format(d);
      const wrap = document.createElement("div");
      wrap.className = "chip";
      wrap.innerHTML = `<input type="radio" name="day" id="${id}" value="${label}, ${fmtDate.format(d)}"><label for="${id}">${label}<small>${fmtDate.format(d)}</small></label>`;
      daysBox.appendChild(wrap);
      added++;
    }
  }

  const value = (name: string) =>
    (form?.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? "");

  const update = () => {
    if (!summary) return;
    const r = value("reason"), d = value("day"), t = value("time");
    if (errorBox) errorBox.textContent = "";
    summary.innerHTML = r || d || t
      ? `<strong>${r || "Reason?"}</strong> · ${d || "day?"} · ${t || "time?"}`
      : "Choose a reason, a day and a time.";
  };
  form?.addEventListener("change", update);

  // Treatment tiles preselect the booking reason
  document.querySelectorAll<HTMLElement>("[data-reason]").forEach((a) =>
    a.addEventListener("click", () => {
      const input = document.querySelector<HTMLInputElement>(`[data-reason-input="${a.dataset.reason}"]`);
      if (input) {
        input.checked = true;
        update();
      }
    }),
  );

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const r = value("reason"), d = value("day"), t = value("time");
    const missing = [!r && "a reason", !d && "a day", !t && "a time"].filter(Boolean);
    if (missing.length) {
      if (errorBox) errorBox.textContent = `Please choose ${missing.join(", ").replace(/, ([^,]*)$/, " and $1")}.`;
      return;
    }
    form.hidden = true;
    if (done && doneText) {
      doneText.textContent = `${r} on ${d} at ${t}. We'll text you to confirm.`;
      done.hidden = false;
      done.focus();
    }
  });
</script>
